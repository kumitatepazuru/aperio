{
  "name": "aperio",
  "author": "John Doe <john@doe.com>",
  "homepage": "https://github.com/kumitatepazuru/aperio",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/app/main.js",
  "workspaces": [
    "apps/main",
    "apps/preload",
    "apps/ui",
    "apps/osr",
    "apps/dialog",
    "packages/*",
    "plugins/base/frontend/*"
  ],
  "scripts": {
    "ui:start": "vite --config apps/vite.config.ts",
    "ui:build": "vite build --config apps/vite.config.ts",
    "main:build": "rolldown -c apps/main/rolldown.config.js",
    "electron:dev": "wait-on tcp:5173 && cross-env ELECTRON_IS_DEV=1 electron .",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@eslint/js": "^9.36.0",
    "@moonrepo/cli": "^2.6.4",
    "@napi-rs/cli": "^3.5.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@webgpu/types": "^0.1.68",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "electron": "40.0.0-beta.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "react-devtools": "^7.0.1",
    "rolldown": "1.0.0-beta.58",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.0.0-beta.7",
    "wait-on": "^9.0.1"
  },
  "napi": {
    "binaryName": "aperio",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 12.22.0 < 13 || >= 14.17.0 < 15 || >= 15.12.0 < 16 || >= 16.0.0"
  },
  "build": {
    "appId": "io.kumitatepazuru.aperio",
    "productName": "Aperio",
    "directories": {
      "output": "build/release"
    },
    "files": [
      "dist/app/**/*",
      "!node_modules/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/app/*.node"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "dist/resources/${os}-${arch}",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python/aperio_plugin",
        "to": "plmanager/aperio_plugin",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!moon.yml"
        ]
      },
      {
        "from": "build/plugins/",
        "to": "default-plugins/",
        "filter": [
          "*.whl"
        ]
      },
      {
        "from": "dist/app/",
        "to": "app.asar.unpacked/dist/app/",
        "filter": [
          "**/*.so*",
          "**/*.dll",
          "**/*.dylib*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
