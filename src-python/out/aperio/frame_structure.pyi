from collections.abc import Sequence
from typing import Final, final

@final
class FileFilter:
    def __eq__(self, /, other: FileFilter) -> bool: ...
    def __ne__(self, /, other: FileFilter) -> bool: ...
    def __new__(cls, /, name: str, extensions: Sequence[str]) -> FileFilter: ...
    def __repr__(self, /) -> str: ...
    @property
    def extensions(self, /) -> list[str]: ...
    @property
    def name(self, /) -> str: ...

@final
class GenerateStructure(dict): ...

