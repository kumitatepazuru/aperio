from _typeshed import Incomplete
from aperio.gpu_util import PyImageGenerator, PyTexture
from collections.abc import Sequence
from typing import Final, final

@final
class ColorFormat:
    Rgb16Float: Final[ColorFormat]
    RgbUnorm: Final[ColorFormat]
    Rgba16Float: Final[ColorFormat]
    RgbaUnorm: Final[ColorFormat]
    def __eq__(self, /, other: ColorFormat) -> bool: ...
    def __int__(self, /) -> int: ...
    def __ne__(self, /, other: ColorFormat) -> bool: ...
    def __repr__(self, /) -> str: ...

@final
class PyVideoLoader:
    def __new__(cls, /, path: str, target_fps: float, image_generator: PyImageGenerator) -> PyVideoLoader: ...
    @property
    def color_format(self, /) -> ColorFormat: ...
    def get_frame(self, /, frame_number: int) -> Incomplete: ...
    def get_frame_for_pipeline(self, /, _inputs: Sequence[PyTexture], frame_number: int) -> PyTexture |None: ...
    def get_texture_frame(self, /, frame_number: int) -> PyTexture: ...
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...
