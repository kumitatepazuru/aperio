from .gpu_util import PyImageGenerator, PyTexture
from _typeshed import Incomplete
from collections.abc import Sequence
from typing import Any, Final, final

@final
class ColorFormat:
    Rgb16Float: Final[ColorFormat]
    RgbUnorm: Final[ColorFormat]
    Rgba16Float: Final[ColorFormat]
    RgbaUnorm: Final[ColorFormat]
    def __eq__(self, /, other: ColorFormat) -> bool: ...
    def __int__(self, /) -> int: ...
    def __ne__(self, /, other: ColorFormat) -> bool: ...
    def __repr__(self, /) -> str: ...

@final
class PyAudioLoader:
    def __new__(cls, /, path: str) -> PyAudioLoader: ...
    @property
    def bit_depth(self, /) -> int: ...
    @property
    def chs(self, /) -> int: ...
    @property
    def duration(self, /) -> float: ...
    def get_audio(self, /, time_samples: int, duration_samples: int, *, sample_rate: int |None = None, channels: int |None = None) -> Incomplete: ...
    @property
    def sampling_rate(self, /) -> int: ...

@final
class PyImageLoader:
    def __new__(cls, /, path: str, image_generator: PyImageGenerator) -> PyImageLoader: ...
    @property
    def color_format(self, /) -> ColorFormat: ...
    def get_frame(self, /) -> Incomplete: ...
    def get_frame_for_pipeline(self, /, _inputs: Sequence[PyTexture], _params: Any |None) -> PyTexture |None: ...
    def get_texture_frame(self, /) -> PyTexture: ...
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...

@final
class PyVideoLoader:
    def __new__(cls, /, path: str, image_generator: PyImageGenerator) -> PyVideoLoader: ...
    @property
    def color_format(self, /) -> ColorFormat: ...
    @property
    def fps(self, /) -> float: ...
    @property
    def frame_count(self, /) -> int: ...
    def get_frame(self, /, frame_number: int, target_fps: float) -> Incomplete: ...
    def get_frame_for_pipeline(self, /, _inputs: Sequence[PyTexture], params: tuple[int, float]) -> PyTexture |None: ...
    def get_texture_frame(self, /, frame_number: int, target_fps: float) -> PyTexture: ...
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...
