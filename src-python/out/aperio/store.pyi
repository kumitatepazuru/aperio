from _typeshed import Incomplete
from aperio.frame_structure import ItemStructure
from collections.abc import Sequence
from typing import Any, final

@final
class ColorPickerState:
    def __eq__(self, /, other: ColorPickerState) -> bool: ...
    def __ne__(self, /, other: ColorPickerState) -> bool: ...
    def __new__(cls, /, color_space: str, display_mode: str, history: Sequence[Sequence[float]]) -> ColorPickerState: ...
    def __repr__(self, /) -> str: ...
    @property
    def color_space(self, /) -> str: ...
    @property
    def display_mode(self, /) -> str: ...
    @property
    def history(self, /) -> list[list[float]]: ...

@final
class FrameState:
    def __eq__(self, /, other: FrameState) -> bool: ...
    def __ne__(self, /, other: FrameState) -> bool: ...
    def __new__(cls, /, width: int, height: int, fps: float) -> FrameState: ...
    def __repr__(self, /) -> str: ...
    @property
    def fps(self, /) -> float: ...
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...

@final
class StoreManager:
    def get_state(self, /) -> SyncableState: ...
    def set_partial(self, /, partial: SyncableStatePartial) -> None: ...

@final
class SyncableState:
    def __eq__(self, /, other: SyncableState) -> bool: ...
    def __ne__(self, /, other: SyncableState) -> bool: ...
    def __new__(cls, /, viewer_state: ViewerState, timeline_items: Sequence[ItemStructure], frame_state: FrameState, audio_state: Any, selected_item_ids: Sequence[str], main_selected_item_id: Incomplete, color_picker: ColorPickerState) -> SyncableState: ...
    def __repr__(self, /) -> str: ...
    @property
    def audio_state(self, /) -> Any: ...
    @property
    def color_picker(self, /) -> ColorPickerState: ...
    @property
    def frame_state(self, /) -> FrameState: ...
    @property
    def main_selected_item_id(self, /) -> Incomplete: ...
    @property
    def selected_item_ids(self, /) -> list[str]: ...
    @property
    def timeline_items(self, /) -> list[Incomplete]: ...
    @property
    def viewer_state(self, /) -> ViewerState: ...

@final
class SyncableStatePartial: ...

@final
class ViewerState:
    def __eq__(self, /, other: ViewerState) -> bool: ...
    def __ne__(self, /, other: ViewerState) -> bool: ...
    def __new__(cls, /, state: str, change_time: float, begin_frame: int) -> ViewerState: ...
    def __repr__(self, /) -> str: ...
    @property
    def begin_frame(self, /) -> int: ...
    @property
    def change_time(self, /) -> float: ...
    @property
    def state(self, /) -> str: ...
