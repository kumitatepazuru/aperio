from aperio.gpu_util import PyImageGenerator, PyTexture
from collections.abc import Sequence
from typing import final

@final
class PyCharGlyphData:
    @property
    def ch(self, /) -> str: ...
    @property
    def h(self, /) -> int: ...
    @property
    def w(self, /) -> int: ...
    @property
    def x(self, /) -> int: ...
    @property
    def y(self, /) -> int: ...

@final
class PyPreparedText:
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...

@final
class PyTextRenderer:
    def __new__(cls, /, device: PyImageGenerator) -> PyTextRenderer: ...
    def get_fonts_list(self, /) -> dict[str, list[int]]: ...
    def prepare_render_text(self, /, spec: PyTextSpec) -> PyPreparedText |None: ...
    def render_text_for_pipeline(self, /, _inputs: Sequence[PyTexture], prepared: PyPreparedText) -> PyTexture |None: ...
    def run_render_chars(self, /, prepared: PyPreparedText) -> list[tuple[PyCharGlyphData, PyTexture]]: ...
    def run_render_text(self, /, prepared: PyPreparedText) -> PyTexture: ...

@final
class PyTextSpec:
    def __new__(cls, /, text: str, font_size: float, color: Sequence[float], font_family: str |None, font_weight: int |None, max_width: int |None, line_spacing: float, char_spacing: float) -> PyTextSpec: ...
