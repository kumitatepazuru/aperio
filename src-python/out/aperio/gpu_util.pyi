from collections.abc import Sequence
from typing import Any, Final, final

@final
class PyCompiledFunc:
    def __new__(cls, /, id: str, func: Any) -> PyCompiledFunc: ...

@final
class PyCompiledTextureFunc:
    def __new__(cls, /, id: str, func: Any) -> PyCompiledTextureFunc: ...

@final
class PyCompiledWgsl:
    def __new__(cls, /, name: str, wgsl_code: str, generator: PyImageGenerator, sampler_options: PySamplerOptions |None = None, min_output_format: WrappedImagePixelFormat |None = None) -> PyCompiledWgsl: ...
    @staticmethod
    def compose_new(name: str, composable_modules: Sequence[PyComposableModuleDescriptor], naga_module: PyNagaModuleDescriptor, generator: PyImageGenerator, sampler_options: PySamplerOptions |None = None, min_output_format: WrappedImagePixelFormat |None = None) -> PyCompiledWgsl: ...

@final
class PyComposableModuleDescriptor: ...

@final
class PyImageGenerateBuilder:
    def __new__(cls, /) -> PyImageGenerateBuilder: ...
    def add_func(self, /, func: PyCompiledFunc, params: Any |None, output_width: int, output_height: int) -> PyImageGenerateBuilder: ...
    def add_linked(self, /, linked_id: str, output_width: int, output_height: int) -> PyImageGenerateBuilder: ...
    def add_parallel_wgsl(self, /, pipelines: Sequence[PyImageGenerateBuilder]) -> PyImageGenerateBuilder: ...
    def add_texture_func(self, /, func: PyCompiledTextureFunc, params: Any |None, output_width: int, output_height: int) -> PyImageGenerateBuilder: ...
    def add_wgsl(self, /, wgsl: PyCompiledWgsl, params: bytes |None, output_width: int, output_height: int) -> PyImageGenerateBuilder: ...
    def get_id_tree(self, /) -> list[Any]: ...

@final
class PyImageGenerator:
    def __new__(cls, /, format: WrappedImagePixelFormat) -> PyImageGenerator: ...
    def generate_buf(self, /, builder: PyImageGenerateBuilder, buffer_ptr: int) -> None: ...
    def generate_shared_texture(self, /, builder: PyImageGenerateBuilder, texture_handle: PySharedTextureHandle, format: WrappedSharedTextureFormat) -> None: ...
    @property
    def maximum_texture_size(self, /) -> int: ...

@final
class PyNagaModuleDescriptor: ...

@final
class PySamplerOptions:
    def __new__(cls, /, address_mode: str, filter: str) -> PySamplerOptions: ...

@final
class PySharedTextureHandle: ...

@final
class PyTexture:
    @property
    def height(self, /) -> int: ...
    @property
    def width(self, /) -> int: ...

@final
class WrappedImagePixelFormat:
    Rgba16Float: Final[WrappedImagePixelFormat]
    Rgba32Float: Final[WrappedImagePixelFormat]
    Rgba8Unorm: Final[WrappedImagePixelFormat]
    def __eq__(self, /, other: WrappedImagePixelFormat) -> bool: ...
    def __int__(self, /) -> int: ...
    def __ne__(self, /, other: WrappedImagePixelFormat) -> bool: ...
    def __repr__(self, /) -> str: ...

@final
class WrappedSharedTextureFormat:
    Bgra8Unorm: Final[WrappedSharedTextureFormat]
    Rgba16Float: Final[WrappedSharedTextureFormat]
    def __eq__(self, /, other: WrappedSharedTextureFormat) -> bool: ...
    def __int__(self, /) -> int: ...
    def __ne__(self, /, other: WrappedSharedTextureFormat) -> bool: ...
    def __repr__(self, /) -> str: ...

def create_composable_module(file_path: str, shader_defs: dict |None = None) -> PyComposableModuleDescriptor: ...
def create_naga_module(file_path: str, shader_defs: dict |None = None) -> PyNagaModuleDescriptor: ...
